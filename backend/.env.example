# Local defaults automatically resolve ../models/*_finetuned when those folders exist.
# For deployment set each value to its fine-tuned Hugging Face repository or mounted path.
INDOBERT_MODEL_ID=Tipuls/indobert-financial-sentiment
INDOLEM_MODEL_ID=Tipuls/indolem-financial-sentiment
FINBERT_MODEL_ID=Tipuls/finbert-financial-sentiment
# Set only in the backend environment when private Hub repositories require it.
# HF_TOKEN=
HF_HOME=./hf_cache
MAX_CACHED_MODELS=1
MAX_TEXT_CHARS=8000
TRANSLATION_PROVIDER=google
CORS_ORIGINS=http://localhost:3000
